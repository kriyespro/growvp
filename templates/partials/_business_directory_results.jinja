{% if open_now_featured %}
<section class="mb-5">
  <div class="mb-2 flex items-center justify-between gap-3">
    <h2 class="text-sm font-bold text-textMain">Open right now</h2>
  </div>
  <div class="no-scrollbar -mx-4 flex snap-x snap-mandatory gap-2.5 overflow-x-auto px-4 pb-1 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-3 sm:overflow-visible sm:px-0 lg:grid-cols-4">
    {% for business in open_now_featured %}
    <a href="/b/{{ business.slug }}/" class="group w-[68%] max-w-[13rem] shrink-0 snap-start overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition hover:border-green-500/40 sm:w-auto sm:max-w-none">
      <div class="relative h-20 overflow-hidden bg-stone-100">
        <img src="{{ business.public_hero_image_url|img_url(360) }}" alt="" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" decoding="async" width="360" height="180" data-fallbacks="{{ business.image_fallbacks }}" onerror="sbImgFallback(this)">
        <span class="absolute bottom-1.5 left-1.5 rounded-full bg-green-600 px-1.5 py-0.5 text-[10px] font-semibold text-white">{{ business.today_label }}</span>
      </div>
      <div class="px-2.5 py-2">
        <p class="truncate text-sm font-semibold text-textMain group-hover:text-brand">{{ business.name }}</p>
        <p class="mt-0.5 truncate text-[11px] text-textMuted">{{ business.area_label or business.get_industry_type_display() }}{% if business.price_range_label %} · {{ business.price_range_label }}{% endif %}</p>
      </div>
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}

<div class="mb-4 flex flex-wrap items-center justify-between gap-2 border-b border-stone-200 pb-3">
  <div>
    <h2 class="text-base font-bold text-textMain sm:text-lg">All listings</h2>
    <p class="mt-0.5 text-sm text-textMuted">
    {% if total_count == 0 %}
      No businesses found
    {% elif total_count == 1 %}
      <span class="font-semibold text-textMain">1</span> business
    {% elif list_limited %}
      Showing <span class="font-semibold text-textMain">{{ result_count }}</span> of {{ total_count }}
    {% else %}
      Showing <span class="font-semibold text-textMain">{{ result_count }}</span> businesses
    {% endif %}
    {% if q %} matching “{{ q }}”{% endif %}
    {% if industry %}
      {% for value, label in industries %}
        {% if value == industry %}· {{ label }}{% endif %}
      {% endfor %}
    {% endif %}
    {% if availability == 'open' %}· Open now{% endif %}
    {% if bookable == '1' %}· Bookable{% endif %}
    {% if verified == '1' %}· Verified{% endif %}
    </p>
  </div>
</div>

{% if not businesses %}
  <div class="rounded-2xl border border-dashed border-stone-300 bg-white/80 px-6 py-10 text-center">
    <p class="font-display text-lg font-bold text-textMain">No matching businesses</p>
    <p class="mt-1 text-sm text-textMuted">Clear filters or try another search.</p>
    <div class="mt-4 flex flex-wrap justify-center gap-2">
      <a href="/" class="inline-flex rounded-md border border-stone-300 bg-white px-4 py-2 text-sm font-semibold text-textMain hover:bg-stone-50">Clear filters</a>
      <a href="/auth/register/" class="inline-flex rounded-md bg-brand px-4 py-2 text-sm font-semibold text-white hover:bg-brandHover">List your business</a>
    </div>
  </div>
{% else %}
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
    {% for business in businesses %}
      {% include 'partials/_business_card.jinja' %}
    {% endfor %}
  </div>
  {% if list_limited %}
  <p class="mt-5 text-center text-sm text-textMuted">
    Showing top {{ result_count }} results — refine with search or category filters.
  </p>
  {% endif %}
{% endif %}
