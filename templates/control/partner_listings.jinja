{% extends 'control/base_control.jinja' %}

{% block title %}Partner listings{% endblock %}
{% block page_title %}Partner listings{% endblock %}

{% block content %}
<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <div>
    <p class="text-sm text-control-muted">Entries created by or assigned to marketing partners · {{ total_count }} total</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="{{ url('control:partner_listings_export') }}?format=csv{% if q %}&q={{ q }}{% endif %}{% if partner_id %}&partner={{ partner_id }}{% endif %}" class="rounded-md border border-control-border px-3 py-2 text-xs font-semibold text-control-muted hover:text-white">Export CSV</a>
    <a href="{{ url('control:partner_listings_export') }}?format=xlsx{% if q %}&q={{ q }}{% endif %}{% if partner_id %}&partner={{ partner_id }}{% endif %}" class="rounded-md border border-control-border px-3 py-2 text-xs font-semibold text-control-muted hover:text-white">Export Excel</a>
    <a href="{{ url('control:partner_listings_import') }}" class="rounded-md bg-control-accent px-3 py-2 text-xs font-bold text-black hover:opacity-90">Import</a>
  </div>
</div>

{% if deleted %}
<div class="mb-4 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-300">Deleted {{ deleted }} listing(s).</div>
{% endif %}
{% if saved %}
<div class="mb-4 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-300">Listing saved.</div>
{% endif %}

<form method="get" class="mb-4 flex flex-wrap gap-2">
  <input type="search" name="q" value="{{ q or '' }}" placeholder="Search name, slug, phone, partner…" class="w-full max-w-md rounded-md border border-control-border bg-control-panel px-3 py-2 text-sm">
  <select name="partner" class="rounded-md border border-control-border bg-control-panel px-3 py-2 text-sm">
    <option value="">All partners</option>
    {% for p in partners %}
    <option value="{{ p.id }}" {% if partner_id == p.id %}selected{% endif %}>{{ p.email }}</option>
    {% endfor %}
  </select>
  <button type="submit" class="rounded-md border border-control-border px-3 py-2 text-xs font-semibold text-control-muted hover:text-white">Filter</button>
</form>

<form method="post" action="{{ url('control:partner_listings_bulk_delete') }}" x-data="{ all: false, selected: 0 }" @change="selected = [...$el.querySelectorAll('input[name=ids]:checked')].length">
  {{ csrf_field(request) }}
  <div class="mb-3 flex flex-wrap items-center gap-2">
    <button
      type="submit"
      class="rounded-md border border-red-500/40 bg-red-500/10 px-3 py-2 text-xs font-semibold text-red-300 hover:bg-red-500/20 disabled:opacity-40"
      :disabled="selected === 0"
      onclick="return confirm('Delete selected partner listings? This cannot be undone.')"
    >
      Bulk delete (<span x-text="selected">0</span>)
    </button>
    <a
      class="rounded-md border border-control-border px-3 py-2 text-xs font-semibold text-control-muted hover:text-white"
      :href="'{{ url('control:partner_listings_export') }}?format=csv&' + [...document.querySelectorAll('input[name=ids]:checked')].map(i => 'id=' + i.value).join('&')"
    >Export selected CSV</a>
    <p class="text-xs text-control-muted">Tip: export → edit in Google Sheets / Excel → import again for bulk updates via new rows.</p>
  </div>

  <div class="overflow-x-auto rounded-xl border border-control-border bg-control-panel">
    <table class="min-w-full text-left text-sm">
      <thead class="border-b border-control-border text-[11px] uppercase text-control-muted">
        <tr>
          <th class="px-3 py-3">
            <input type="checkbox" class="rounded border-control-border" @change="all = $event.target.checked; document.querySelectorAll('input[name=ids]').forEach(cb => cb.checked = all); selected = all ? {{ businesses|length }} : 0">
          </th>
          <th class="px-3 py-3">Listing</th>
          <th class="px-3 py-3">Partner</th>
          <th class="px-3 py-3">Plan</th>
          <th class="px-3 py-3">Phone</th>
          <th class="px-3 py-3">Created</th>
          <th class="px-3 py-3"></th>
        </tr>
      </thead>
      <tbody>
        {% for b in businesses %}
        <tr class="border-b border-control-border/60">
          <td class="px-3 py-3">
            <input type="checkbox" name="ids" value="{{ b.id }}" class="rounded border-control-border">
          </td>
          <td class="px-3 py-3">
            <a href="/b/{{ b.slug }}/" class="text-control-link hover:underline" target="_blank">{{ b.name }}</a>
            <p class="text-xs text-control-muted">{{ b.get_industry_type_display() }} · /b/{{ b.slug }}/</p>
          </td>
          <td class="px-3 py-3 text-control-muted text-xs">
            {% if b.created_by %}{{ b.created_by.email }}{% else %}—{% endif %}
            {% set assigned = b.assigned_partners.all() %}
            {% if assigned %}
            <p class="mt-0.5">Assigned: {% for p in assigned %}{{ p.email }}{% if not loop.last %}, {% endif %}{% endfor %}</p>
            {% endif %}
          </td>
          <td class="px-3 py-3">{{ b.plan_label }}</td>
          <td class="px-3 py-3 text-control-muted">{{ b.public_phone or '—' }}</td>
          <td class="px-3 py-3 text-control-muted text-xs">{{ b.created_at.strftime('%Y-%m-%d') if b.created_at else '—' }}</td>
          <td class="px-3 py-3 text-right">
            <a href="{{ url('control:partner_listing_edit', kwargs={'pk': b.id}) }}" class="rounded-md bg-white/10 px-2.5 py-1.5 text-xs font-semibold hover:bg-white/15">Edit</a>
          </td>
        </tr>
        {% else %}
        <tr><td colspan="7" class="px-4 py-8 text-center text-control-muted">No partner listings found.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</form>

<div class="mt-4 rounded-xl border border-control-border bg-control-panel p-4 text-sm text-control-muted">
  <p class="font-semibold text-control-text">Google Sheets workflow</p>
  <ol class="mt-2 list-decimal space-y-1 pl-5">
    <li>Click <strong>Export CSV</strong> or Excel.</li>
    <li>File → Import into Google Sheets (or open .xlsx).</li>
    <li>Edit rows, then Share → Anyone with link → Viewer.</li>
    <li>Paste the sheet URL on the Import page (or re-upload CSV/Excel).</li>
  </ol>
</div>
{% endblock %}
