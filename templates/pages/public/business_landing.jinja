{% extends 'base.jinja' %}

{% block title %}{{ business.name }} | Book Appointment{% endblock %}

{% block content %}
<div class="bg-stone-50 min-h-screen pb-20">
  <header class="sticky top-0 z-30 border-b border-stone-200 bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
      <p class="truncate text-sm font-semibold text-textMain">{{ business.name }}</p>
      <a href="/booking/{{ business.slug }}/" class="inline-flex items-center justify-center rounded-md bg-brand px-3 py-2 text-xs font-semibold text-white shadow-sm hover:bg-brandHover sm:text-sm">
        Book Now
      </a>
    </div>
  </header>

  <section class="px-4 pt-8 pb-12 sm:px-6 sm:pt-14 sm:pb-16 lg:px-8 bg-gradient-to-b from-brand/10 to-stone-50">
    <div class="mx-auto max-w-6xl text-center">
      <div class="inline-flex items-center rounded-full bg-brand/10 px-3 py-1 text-xs sm:text-sm text-brand ring-1 ring-brand/20">
        {{ business.get_industry_type_display() }}
      </div>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-textMain sm:mt-6 sm:text-5xl lg:text-6xl">{{ business.hero_title or business.name }}</h1>
      <p class="mt-4 text-base leading-7 text-textMuted max-w-3xl mx-auto sm:mt-6 sm:text-lg sm:leading-8">
        {{ business.hero_subtitle or "Book trusted services online with transparent pricing and quick slot confirmation." }}
      </p>
      <div class="mt-6 mx-auto max-w-4xl overflow-hidden rounded-xl sm:rounded-2xl border border-stone-200 shadow-sm bg-white">
        <img src="{{ business.public_hero_image_url }}" alt="{{ business.name }}" class="h-44 w-full object-cover sm:h-64 lg:h-80">
      </div>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:mt-10 sm:flex-row sm:gap-x-6">
        <a href="/booking/{{ business.slug }}/" class="w-full sm:w-auto rounded-md bg-brand px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brandHover text-center">
          Book Appointment
        </a>
        {% if business.public_phone %}
        <a href="tel:{{ business.public_phone }}" class="w-full sm:w-auto rounded-md border border-stone-300 bg-white px-5 py-3 text-sm font-semibold text-textMain hover:bg-stone-50 text-center">
          Call Now
        </a>
        {% endif %}
      </div>
    </div>
  </section>

  <section id="contact-location" class="mx-auto max-w-6xl px-4 pb-14 sm:px-6 sm:pb-20 lg:px-8">
    <div class="mb-5 flex flex-col gap-3 sm:mb-6 sm:flex-row sm:items-center sm:justify-between">
      <h2 class="text-xl font-bold text-textMain sm:text-2xl">Services & Pricing</h2>
      <a href="/booking/{{ business.slug }}/" class="text-sm font-semibold text-brand hover:text-brandHover">Book Now</a>
    </div>
    {% if not services %}
      <div class="rounded-xl border border-stone-200 bg-white p-6 sm:p-8 text-center text-textMuted">
        Services will be listed soon.
      </div>
    {% else %}
      <div class="grid grid-cols-1 gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {% for service in services %}
          <article class="overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm">
            {% if service.image %}
              <img src="{{ service.image.url }}" alt="{{ service.name }}" class="h-40 w-full object-cover sm:h-44">
            {% elif service.image_url %}
              <img src="{{ service.image_url }}" alt="{{ service.name }}" class="h-40 w-full object-cover sm:h-44">
            {% else %}
              <img src="{{ business.default_public_image_url }}" alt="{{ service.name }}" class="h-40 w-full object-cover sm:h-44">
            {% endif %}
            <div class="p-4 sm:p-5">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-base sm:text-lg font-semibold text-textMain">{{ service.name }}</h3>
                <span class="text-base font-bold text-brand">₹{{ service.price }}</span>
              </div>
              <p class="mt-1 text-xs text-textMuted">{{ service.category.name }} • {{ service.duration_mins }} mins</p>
              <p class="mt-3 text-sm text-textMuted">{{ service.description or "Professional service with quality care." }}</p>
              <a href="/booking/{{ business.slug }}/" class="mt-4 inline-flex w-full sm:w-auto items-center justify-center rounded-md bg-stone-100 px-3 py-2 text-sm font-semibold text-textMain hover:bg-stone-200">
                Choose Slot
              </a>
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </section>

  {% if business.testimonial_quote %}
  <section class="mx-auto max-w-4xl px-4 pb-8 sm:px-6 sm:pb-10 lg:px-8">
    <div class="rounded-xl sm:rounded-2xl bg-white border border-stone-200 p-5 sm:p-8 text-center shadow-sm">
      <p class="text-base sm:text-lg text-textMain italic">"{{ business.testimonial_quote }}"</p>
      {% if business.testimonial_author %}
      <p class="mt-4 text-sm font-semibold text-brand">- {{ business.testimonial_author }}</p>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {% if business.public_phone or business.public_email or business.public_address or business.map_embed_url %}
  <section class="mx-auto max-w-6xl px-4 pb-14 sm:px-6 sm:pb-20 lg:px-8">
    <div class="grid grid-cols-1 gap-4 sm:gap-6 lg:grid-cols-2">
      <div class="rounded-xl sm:rounded-2xl bg-white border border-stone-200 p-5 sm:p-6 shadow-sm">
        <h3 class="text-lg sm:text-xl font-bold text-textMain mb-4">Contact & Location</h3>
        {% if business.public_phone %}<p class="text-sm text-textMuted mb-2"><span class="font-semibold text-textMain">Phone:</span> <a class="hover:text-brand" href="tel:{{ business.public_phone }}">{{ business.public_phone }}</a></p>{% endif %}
        {% if business.public_email %}<p class="text-sm text-textMuted mb-2"><span class="font-semibold text-textMain">Email:</span> <a class="hover:text-brand" href="mailto:{{ business.public_email }}">{{ business.public_email }}</a></p>{% endif %}
        {% if business.public_address %}<p class="text-sm text-textMuted"><span class="font-semibold text-textMain">Address:</span> {{ business.public_address }}</p>{% endif %}
      </div>
      <div class="rounded-xl sm:rounded-2xl bg-white border border-stone-200 p-3 shadow-sm">
        {% if business.map_embed_url %}
        <iframe src="{{ business.map_embed_url }}" class="w-full h-52 sm:h-56 rounded-lg sm:rounded-xl border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        {% else %}
        <div class="w-full h-52 sm:h-56 rounded-lg sm:rounded-xl bg-stone-100 flex items-center justify-center text-stone-400 text-sm">Map not configured</div>
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}
</div>
<nav class="sm:hidden fixed bottom-0 inset-x-0 z-30 border-t border-stone-200 bg-white/95 backdrop-blur">
  <div class="grid grid-cols-3 gap-1 p-2">
    <a href="/b/{{ business.slug }}/" class="flex items-center justify-center rounded-lg py-3 text-xs font-semibold text-textMain bg-stone-100">Home</a>
    <a href="/booking/{{ business.slug }}/" class="flex items-center justify-center rounded-lg py-3 text-xs font-semibold text-textMain hover:bg-stone-100">Book</a>
    <a href="#contact-location" class="flex items-center justify-center rounded-lg py-3 text-xs font-semibold text-textMain hover:bg-stone-100">Contact</a>
  </div>
</nav>
{% endblock %}
