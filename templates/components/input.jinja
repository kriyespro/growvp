{% macro render(label, name, type="text", placeholder="", required=False, value="", errors="") %}
<div class="space-y-1">
    <label for="{{ name }}" class="block text-sm font-medium text-textMain">{{ label }}</label>
    <input 
        type="{{ type }}" 
        name="{{ name }}" 
        id="{{ name }}"
        value="{{ value }}"
        {% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
        {% if required %}required{% endif %}
        class="block w-full rounded-md border-0 bg-white py-2.5 px-4 text-textMain shadow-sm ring-1 ring-inset {% if errors %}ring-red-500 focus:ring-red-500{% else %}ring-stone-300 focus:ring-brand{% endif %} focus:ring-2 focus:ring-inset sm:text-sm sm:leading-6 transition-all"
    />
    {% if errors %}
        <p class="text-xs text-red-500 mt-1">{{ errors }}</p>
    {% endif %}
</div>
{% endmacro %}
