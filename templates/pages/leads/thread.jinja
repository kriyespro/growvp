{% extends 'base.jinja' %}
{% import 'components/button.jinja' as btn %}

{% block title %}{{ enquiry.subject or 'Enquiry' }} | SuratBazar{% endblock %}

{% block content %}
<div class="min-h-screen bg-stone-50 px-4 py-8 sm:px-6">
  <div class="mx-auto max-w-2xl">
    <a href="/leads/" class="text-sm font-semibold text-brand">← Inbox</a>
    <h1 class="mt-3 font-display text-2xl font-bold text-textMain">{{ enquiry.subject or ('Enquiry #' ~ enquiry.id) }}</h1>
    <p class="mt-1 text-sm text-textMuted">
      {{ enquiry.business.name }} · {{ enquiry.client.email }} · {{ enquiry.get_status_display() }}
    </p>

    <div class="mt-6 space-y-3">
      {% for m in messages %}
      <div class="rounded-xl border border-stone-200 bg-white p-4 {% if m.sender_id == request.user.id %}border-brand/30 bg-brand/5{% endif %}">
        <div class="flex items-center justify-between gap-2 text-xs text-textMuted">
          <span class="font-semibold text-textMain">{{ m.sender.email }}</span>
          <span>{{ m.created_at.strftime('%d %b %H:%M') }}</span>
        </div>
        <p class="mt-2 whitespace-pre-wrap text-sm text-textMain">{{ m.body }}</p>
      </div>
      {% endfor %}
    </div>

    <form method="post" class="mt-6 space-y-3 rounded-xl border border-stone-200 bg-white p-4 shadow-sm">
      {{ csrf_field(request) }}
      {% if error %}<p class="text-sm text-red-600">{{ error }}</p>{% endif %}
      <label class="block text-sm font-medium text-textMain">Reply</label>
      <textarea name="body" rows="3" required class="block w-full rounded-md border-0 py-2.5 px-4 text-sm shadow-sm ring-1 ring-inset ring-stone-300 focus:ring-2 focus:ring-brand"></textarea>
      {{ btn.render(type="submit", text="Send reply", cls="justify-center") }}
    </form>
  </div>
</div>
{% endblock %}
