{% extends 'pages/partner/base_partner.jinja' %}
{% import 'components/input.jinja' as input %}
{% import 'components/button.jinja' as btn %}

{% block partner_content %}
<a href="/partner/listings/" class="text-sm font-semibold text-brand">← Listings</a>
<h2 class="mt-3 font-display text-2xl font-bold text-textMain">Create listing</h2>
<form method="post" class="mt-6 max-w-lg space-y-4 rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
  {{ csrf_field(request) }}
  {{ input.render("Business name", "name", required=True, value=form.name.value() or "") }}
  <div class="space-y-1">
    <label class="block text-sm font-medium text-textMain">Category</label>
    <select name="industry_type" required class="block w-full rounded-md border-0 bg-white py-2.5 px-4 text-sm shadow-sm ring-1 ring-inset ring-stone-300">
      {% for value, label in form.fields.industry_type.choices %}
      <option value="{{ value }}" {% if form.industry_type.value() == value %}selected{% endif %}>{{ label }}</option>
      {% endfor %}
    </select>
  </div>
  {{ input.render("Phone", "public_phone", value=form.public_phone.value() or "") }}
  {{ btn.render(type="submit", text="Create listing", cls="w-full justify-center") }}
</form>
{% endblock %}
