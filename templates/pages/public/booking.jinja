{% extends 'base.jinja' %}
{% import 'components/input.jinja' as input %}
{% import 'components/button.jinja' as btn %}

{% block title %}Book appointment — {{ business.name }} | SuratBazar{% endblock %}
{% block meta_description %}Book an appointment online at {{ business.name }}. Choose a service, pick a time, and confirm in minutes.{% endblock %}
{% block robots %}index, follow{% endblock %}

{% block content %}
<div class="min-h-screen bg-stone-50 flex flex-col justify-center py-8 px-4 pb-24 sm:py-12 sm:px-6 lg:px-8">
    <div class="mx-auto w-full max-w-xl">
        <a href="/b/{{ business.slug }}/" class="inline-flex items-center text-sm font-semibold text-brand hover:text-brandHover">← Back to business page</a>
    </div>
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-textMain">{{ business.name }}</h2>
        <p class="mt-2 text-center text-sm text-textMuted">Book your appointment online instantly.</p>
    </div>

    <div class="mt-6 sm:mt-8 sm:mx-auto sm:w-full sm:max-w-xl">
        <div class="bg-creameSurface py-8 px-4 shadow sm:rounded-lg sm:px-10 border border-stone-200">
            <form hx-post="/booking/b/{{ business.id }}/" hx-target="body" class="space-y-6">
                {% if error_message %}
                    <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                        {{ error_message }}
                    </div>
                {% endif %}

                <div class="space-y-1">
                    <label class="block text-sm font-medium text-textMain">Select Service</label>
                    <select name="service" required class="block w-full rounded-md border-0 bg-white py-2.5 px-4 text-textMain shadow-sm ring-1 ring-inset ring-stone-300 focus:ring-2 focus:ring-brand sm:text-sm appearance-none">
                        <option value="">-- Choose a Service --</option>
                        {% for s in services %}
                            <option value="{{ s.id }}" {% if selected_service_id == s.id %}selected{% endif %}>{{ s.name }} (₹{{ s.price }} - {{ s.duration_mins }}m)</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    {{ input.render("Date", "date", type="date", required=True) }}
                    {{ input.render("Preferred Time", "time", type="time", required=True) }}
                </div>

                {{ input.render("Your Name", "first_name", required=True) }}
                {{ input.render("WhatsApp / Phone Number", "phone", type="tel", required=True) }}

                <div class="pt-2">
                    {{ btn.render(type="submit", text="Confirm Booking", cls="w-full justify-center text-lg py-3") }}
                </div>
            </form>
        </div>
        {% if not hide_platform_branding %}
        <p class="text-center text-xs text-stone-400 mt-6">Booked via SuratBazar</p>
        {% endif %}
    </div>
</div>
<nav class="sm:hidden fixed bottom-0 inset-x-0 z-30 border-t border-stone-200 bg-white/95 backdrop-blur">
    <div class="grid grid-cols-3 gap-1 p-2">
        <a href="/b/{{ business.slug }}/" class="flex items-center justify-center rounded-lg py-3 text-xs font-semibold text-textMain hover:bg-stone-100">Home</a>
        <a href="/booking/{{ business.slug }}/" class="flex items-center justify-center rounded-lg py-3 text-xs font-semibold text-textMain bg-stone-100">Book</a>
        <a href="/b/{{ business.slug }}/#contact-location" class="flex items-center justify-center rounded-lg py-3 text-xs font-semibold text-textMain hover:bg-stone-100">Contact</a>
    </div>
</nav>
{% endblock %}
