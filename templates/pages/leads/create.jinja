{% extends 'base.jinja' %}
{% import 'components/input.jinja' as input %}
{% import 'components/button.jinja' as btn %}

{% block title %}Enquire · {{ business.name }}{% endblock %}

{% block content %}
<div class="min-h-screen bg-stone-50 px-4 py-10">
  <div class="mx-auto max-w-lg">
    <a href="/b/{{ business.slug }}/" class="text-sm font-semibold text-brand">← {{ business.name }}</a>
    <h1 class="mt-3 font-display text-2xl font-bold text-textMain">Send enquiry</h1>
    {% if product %}
    <p class="mt-1 text-sm text-textMuted">About <span class="font-semibold text-textMain">{{ product.name }}</span> · ₹{{ product.price }}</p>
    {% else %}
    <p class="mt-1 text-sm text-textMuted">The business (and their partner, if any) will reply in your account inbox.</p>
    {% endif %}
    <form method="post" class="mt-6 space-y-4 rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
      {{ csrf_field(request) }}
      {% if error %}<p class="text-sm text-red-600">{{ error }}</p>{% endif %}
      {{ input.render("Subject (optional)", "subject", value=form.subject.value() or "") }}
      <div class="space-y-1">
        <label class="block text-sm font-medium">Message</label>
        <textarea name="body" rows="5" required class="block w-full rounded-md border-0 py-2.5 px-4 text-sm ring-1 ring-inset ring-stone-300">{{ form.body.value() or "" }}</textarea>
      </div>
      {{ btn.render(type="submit", text="Send enquiry", cls="w-full justify-center") }}
    </form>
  </div>
</div>
{% endblock %}
