{# Compact home hero — search-first #}
<section class="relative z-10 mx-auto w-full max-w-7xl px-4 pt-4 pb-3 sm:px-6 sm:pt-5 lg:px-8">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
    <span class="inline-flex items-center gap-1.5 rounded-full border border-brand/20 bg-white/90 px-2.5 py-1 text-[11px] font-semibold text-brand shadow-sm">
      <svg class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s7-4.5 7-10a7 7 0 1 0-14 0c0 5.5 7 10 7 10Z"/><circle cx="12" cy="11" r="2.5"/></svg>
      Surat
    </span>
    {% if home_stats %}
    <span class="text-xs text-textMuted">
      <span class="font-semibold text-textMain">{{ home_stats.total }}</span> listed
      · <span class="font-semibold text-green-700">{{ home_stats.open_now }}</span> open
      · <span class="font-semibold text-brand">{{ home_stats.bookable }}</span> bookable
    </span>
    {% endif %}
  </div>

  <h1 class="mt-2.5 font-display text-2xl font-bold tracking-tight text-textMain sm:text-3xl">
    Find &amp; book local businesses in <span class="text-brand">Surat</span>
  </h1>
  <p class="mt-1 max-w-xl text-sm text-textMuted sm:text-base">
    Salons, clinics, gyms &amp; more — hours, prices, book online.
  </p>

  <form
    id="directory-form"
    class="mt-4 rounded-xl border border-stone-200/80 bg-white p-2.5 shadow-md shadow-stone-200/30 sm:p-3"
    hx-get="/directory/search/"
    hx-trigger="keyup changed delay:450ms from:#directory-q, change from:#directory-sort, change from:select[name='industry'], change from:input[name='availability'], change from:input[name='bookable'], change from:input[name='verified']"
    hx-target="#directory-results"
    hx-indicator="#directory-loading"
    hx-push-url="true"
  >
    <div class="flex flex-col gap-2 sm:flex-row sm:items-stretch">
      <label class="relative block flex-1">
        <span class="sr-only">Search businesses</span>
        <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-brand/70">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z"/></svg>
        </span>
        <input
          id="directory-q"
          type="search"
          name="q"
          value="{{ q }}"
          placeholder="Vesu, salon, dentist, gym…"
          class="w-full rounded-lg border border-stone-200 bg-stone-50/80 py-2.5 pl-9 pr-3 text-base text-textMain placeholder:text-stone-400 focus:border-brand focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand/15 sm:text-sm"
          autocomplete="off"
        >
      </label>
      <div class="grid grid-cols-2 gap-2 sm:contents">
        <label class="sm:w-36">
          <span class="sr-only">Category</span>
          <select
            name="industry"
            class="w-full rounded-lg border border-stone-200 bg-stone-50/50 px-2.5 py-2.5 text-sm text-textMain focus:border-brand focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand/15"
          >
            <option value="" {% if not industry %}selected{% endif %}>All categories</option>
            {% for group_label, group_choices in industry_groups %}
            <optgroup label="{{ group_label }}">
              {% for value, label in group_choices %}
              <option value="{{ value }}" {% if industry == value %}selected{% endif %}>{{ label }}</option>
              {% endfor %}
            </optgroup>
            {% endfor %}
          </select>
        </label>
        <label class="sm:w-32">
          <span class="sr-only">Sort</span>
          <select
            id="directory-sort"
            name="sort"
            class="w-full rounded-lg border border-stone-200 bg-stone-50/50 px-2.5 py-2.5 text-sm text-textMain focus:border-brand focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand/15"
          >
            <option value="newest" {% if sort == 'newest' %}selected{% endif %}>Newest</option>
            <option value="popular" {% if sort == 'popular' %}selected{% endif %}>Most booked</option>
            <option value="name" {% if sort == 'name' %}selected{% endif %}>Name A–Z</option>
            <option value="price_low" {% if sort == 'price_low' %}selected{% endif %}>Price ↑</option>
            <option value="price_high" {% if sort == 'price_high' %}selected{% endif %}>Price ↓</option>
          </select>
        </label>
      </div>
    </div>

    <div class="mt-2 flex flex-wrap items-center gap-1.5">
      <label class="cursor-pointer">
        <input type="checkbox" name="availability" value="open" class="peer sr-only" {% if availability == 'open' %}checked{% endif %}>
        <span class="inline-flex min-h-7 items-center rounded-full border border-stone-200 bg-white px-2.5 py-0.5 text-[11px] font-semibold text-textMuted transition peer-checked:border-green-600 peer-checked:bg-green-600 peer-checked:text-white">Open now</span>
      </label>
      <label class="cursor-pointer">
        <input type="checkbox" name="bookable" value="1" class="peer sr-only" {% if bookable == '1' %}checked{% endif %}>
        <span class="inline-flex min-h-7 items-center rounded-full border border-stone-200 bg-white px-2.5 py-0.5 text-[11px] font-semibold text-textMuted transition peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white">Book online</span>
      </label>
      <label class="cursor-pointer">
        <input type="checkbox" name="verified" value="1" class="peer sr-only" {% if verified == '1' %}checked{% endif %}>
        <span class="inline-flex min-h-7 items-center rounded-full border border-stone-200 bg-white px-2.5 py-0.5 text-[11px] font-semibold text-textMuted transition peer-checked:border-sky-700 peer-checked:bg-sky-700 peer-checked:text-white">Verified</span>
      </label>
      {% if q or industry or availability or bookable or verified or (sort and sort != 'newest') %}
      <a href="/" class="ml-auto text-[11px] font-semibold text-brand hover:text-brandHover">Clear</a>
      {% endif %}
      <span id="directory-loading" class="htmx-indicator ml-auto text-[11px] font-medium text-brand">Updating…</span>
    </div>
  </form>

  {% include 'partials/_home_areas_strip.jinja' %}

  <div class="mt-4 border-t border-stone-200/60 pt-3">
    {% include 'partials/_category_icon_strip.jinja' %}
  </div>
</section>
