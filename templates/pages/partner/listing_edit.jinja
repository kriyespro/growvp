{% extends 'pages/partner/base_partner.jinja' %}
{% import 'components/input.jinja' as input %}
{% import 'components/button.jinja' as btn %}

{% block partner_content %}
<a href="/partner/listings/" class="text-sm font-semibold text-brand">← Listings</a>
<div class="mt-3 flex flex-wrap items-center justify-between gap-2">
  <div>
    <h2 class="font-display text-2xl font-bold text-textMain">Edit {{ business.name }}</h2>
    <p class="mt-1 text-sm text-textMuted">
      Plan:
      <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-bold
        {% if business.listing_plan == 'premium' %}bg-amber-100 text-amber-900
        {% elif business.listing_plan == 'pro' %}bg-indigo-100 text-indigo-900
        {% else %}bg-stone-100 text-stone-700{% endif %}">
        {{ plan.name }}
      </span>
      · Public page shows fields unlocked by this plan
    </p>
  </div>
  <a href="/b/{{ business.slug }}/" class="text-sm font-semibold text-brand">Public page ↗</a>
</div>
{% if saved %}
<div class="mt-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">Saved. You can store Pro/Premium fields now — they appear publicly when the plan allows.</div>
{% endif %}

<form method="post" class="mt-6 max-w-2xl space-y-4 rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
  {{ csrf_field(request) }}
  {{ input.render("Name", "name", required=True, value=form.name.value() or "") }}
  <div class="space-y-1">
    <label class="block text-sm font-medium">Category</label>
    <select name="industry_type" class="block w-full rounded-md border-0 py-2.5 px-4 text-sm ring-1 ring-inset ring-stone-300">
      {% for value, label in form.fields.industry_type.choices %}
      <option value="{{ value }}" {% if form.industry_type.value() == value %}selected{% endif %}>{{ label }}</option>
      {% endfor %}
    </select>
  </div>

  <div class="rounded-lg border border-stone-100 bg-stone-50 px-3 py-2 text-xs text-textMuted">
    Free plan shows: photo, phone, address, hero text, booking. Pro+ unlocks website, email, map, testimonial.
  </div>

  {{ input.render("Hero title", "hero_title", value=form.hero_title.value() or "") }}
  <div class="space-y-1">
    <label class="block text-sm font-medium">Hero subtitle</label>
    <textarea name="hero_subtitle" rows="2" class="block w-full rounded-md border-0 py-2.5 px-4 text-sm ring-1 ring-inset ring-stone-300">{{ form.hero_subtitle.value() or "" }}</textarea>
  </div>
  {{ input.render("Listing photo URL", "hero_image_url", type="url", value=form.hero_image_url.value() or "", placeholder="https://…") }}
  <p class="text-xs text-textMuted -mt-2">Shown on Free+ plans.</p>
  {% if business.public_hero_image_url %}
  <img src="{{ business.public_hero_image_url|img_url(480) }}" alt="" class="h-32 w-full rounded-lg object-cover border border-stone-200" loading="lazy">
  {% endif %}
  {{ input.render("Public phone", "public_phone", value=form.public_phone.value() or "") }}
  <div class="space-y-1">
    <label class="block text-sm font-medium">Address</label>
    <textarea name="public_address" rows="2" class="block w-full rounded-md border-0 py-2.5 px-4 text-sm ring-1 ring-inset ring-stone-300">{{ form.public_address.value() or "" }}</textarea>
  </div>

  <div class="border-t border-stone-200 pt-4">
    <p class="text-sm font-semibold text-textMain">Pro / Premium fields <span class="font-normal text-textMuted">(saved always · public when plan allows)</span></p>
  </div>

  <div class="space-y-1 {% if not show_public_email %}opacity-80{% endif %}">
    <label class="block text-sm font-medium">
      Public email
      {% if show_public_email %}<span class="text-xs font-normal text-green-700">· live on public page</span>
      {% else %}<span class="text-xs font-normal text-amber-700">· needs Pro+</span>{% endif %}
    </label>
    <input type="email" name="public_email" value="{{ form.public_email.value() or '' }}" class="block w-full rounded-md border-0 py-2.5 px-4 text-sm ring-1 ring-inset ring-stone-300">
  </div>

  <div class="space-y-1 {% if not website_enabled %}opacity-80{% endif %}">
    <label class="block text-sm font-medium">
      Website URL
      {% if website_enabled %}<span class="text-xs font-normal text-green-700">· live on public page</span>
      {% else %}<span class="text-xs font-normal text-amber-700">· needs Pro+</span>{% endif %}
    </label>
    <input type="url" name="website_url" value="{{ form.website_url.value() or '' }}" class="block w-full rounded-md border-0 py-2.5 px-4 text-sm ring-1 ring-inset ring-stone-300" placeholder="https://…">
  </div>

  <div class="space-y-1 {% if not show_map %}opacity-80{% endif %}">
    <label class="block text-sm font-medium">
      Map embed URL
      {% if show_map %}<span class="text-xs font-normal text-green-700">· live on public page</span>
      {% else %}<span class="text-xs font-normal text-amber-700">· needs Pro+</span>{% endif %}
    </label>
    <input type="url" name="map_embed_url" value="{{ form.map_embed_url.value() or '' }}" class="block w-full rounded-md border-0 py-2.5 px-4 text-sm ring-1 ring-inset ring-stone-300" placeholder="https://…">
  </div>

  <div class="space-y-1 {% if not show_testimonial %}opacity-80{% endif %}">
    <label class="block text-sm font-medium">
      Testimonial quote
      {% if show_testimonial %}<span class="text-xs font-normal text-green-700">· live on public page</span>
      {% else %}<span class="text-xs font-normal text-amber-700">· needs Pro+</span>{% endif %}
    </label>
    <textarea name="testimonial_quote" rows="2" class="block w-full rounded-md border-0 py-2.5 px-4 text-sm ring-1 ring-inset ring-stone-300">{{ form.testimonial_quote.value() or "" }}</textarea>
  </div>

  <div class="space-y-1 {% if not show_testimonial %}opacity-80{% endif %}">
    <label class="block text-sm font-medium">Testimonial author</label>
    <input type="text" name="testimonial_author" value="{{ form.testimonial_author.value() or '' }}" class="block w-full rounded-md border-0 py-2.5 px-4 text-sm ring-1 ring-inset ring-stone-300">
  </div>

  {{ btn.render(type="submit", text="Save listing", cls="justify-center") }}
</form>
{% endblock %}
