DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=suratbazar.online,www.suratbazar.online,159.195.52.197
DJANGO_CSRF_TRUSTED_ORIGINS=https://suratbazar.online,https://www.suratbazar.online

# Public canonical / OG / sitemap base (no trailing slash)
SITE_URL=https://suratbazar.online

# Postgres settings for docker-compose
POSTGRES_DB=suratbazar_prod
POSTGRES_USER=sb_user
POSTGRES_PASSWORD=change-me-strong-password

# Django DB URL (used by dj-database-url; host `db` = compose service name)
DATABASE_URL=postgresql://sb_user:change-me-strong-password@db:5432/suratbazar_prod

# Security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Optional
# REDIS_URL=redis://redis:6379/1
DIRECTORY_CACHE_TTL=60
