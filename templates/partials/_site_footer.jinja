<footer class="mt-auto border-t border-stone-200 bg-stone-900 text-stone-300">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 border-b border-stone-700 pb-8 sm:flex-row sm:items-end sm:justify-between">
      <div>
        {% set logo_height = 'h-14' %}
        {% include 'partials/_brand_logo.jinja' %}
        <p class="mt-2 max-w-md text-sm text-stone-400">Local businesses in Surat — find hours, prices, and book online.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/surat/" class="inline-flex rounded-md border border-stone-600 px-3 py-2 text-xs font-semibold text-white hover:border-brand hover:text-brand">Surat guide</a>
        <a href="/pricing/" class="inline-flex rounded-md border border-stone-600 px-3 py-2 text-xs font-semibold text-white hover:border-brand hover:text-brand">Pricing</a>
        <a href="/auth/register/" class="inline-flex rounded-md bg-brand px-3 py-2 text-xs font-semibold text-white hover:bg-brandHover">List your business</a>
      </div>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-4">
      {% for column in footer_category_columns %}
      <div>
        <h2 class="text-xs font-bold uppercase tracking-wide text-stone-500">{{ column.title }}</h2>
        <ul class="mt-3 space-y-2">
          {% for link in column.links %}
          <li>
            <a href="{{ link.path }}" class="text-sm text-stone-300 hover:text-white">{{ link.label }}</a>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-stone-800 pt-6 text-xs text-stone-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© SuratBazar · Surat, Gujarat</p>
      <p>
        <a href="/robots.txt" class="hover:text-stone-300">robots</a>
        <span class="mx-1.5">·</span>
        <a href="/sitemap.xml" class="hover:text-stone-300">sitemap</a>
      </p>
    </div>
  </div>
</footer>
