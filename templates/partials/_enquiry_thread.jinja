{% import 'components/button.jinja' as btn %}

<a href="/leads/" class="text-sm font-semibold text-brand">← Inbox</a>

<div class="mt-3 flex flex-wrap items-start justify-between gap-3">
  <div class="min-w-0">
    <h1 class="font-display text-2xl font-bold text-textMain">{{ enquiry.subject or ('Enquiry #' ~ enquiry.id) }}</h1>
    <p class="mt-1 text-sm text-textMuted">
      <a href="/b/{{ enquiry.business.slug }}/" class="font-semibold text-textMain hover:text-brand" target="_blank">{{ enquiry.business.name }}</a>
      · {{ enquiry.client.email }}
      {% if enquiry.client.first_name %} · {{ enquiry.client.first_name }} {{ enquiry.client.last_name }}{% endif %}
    </p>
  </div>
  <span class="rounded-full px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide
    {% if enquiry.status == 'open' %}bg-brand/10 text-brand
    {% elif enquiry.status == 'replied' %}bg-emerald-100 text-emerald-800
    {% else %}bg-stone-100 text-stone-600{% endif %}">{{ enquiry.get_status_display() }}</span>
</div>

{% if can_manage_status %}
<div class="mt-4 flex flex-wrap gap-2">
  <form method="post" action="/leads/{{ enquiry.id }}/status/">
    {{ csrf_field(request) }}
    <input type="hidden" name="next" value="/leads/{{ enquiry.id }}/">
    <button type="submit" name="status" value="open" class="rounded-md border border-stone-300 bg-white px-3 py-1.5 text-xs font-semibold {% if enquiry.status == 'open' %}ring-2 ring-brand/40{% endif %}">Mark open</button>
  </form>
  {% if layout != 'account' %}
  <form method="post" action="/leads/{{ enquiry.id }}/status/">
    {{ csrf_field(request) }}
    <input type="hidden" name="next" value="/leads/{{ enquiry.id }}/">
    <button type="submit" name="status" value="replied" class="rounded-md border border-stone-300 bg-white px-3 py-1.5 text-xs font-semibold {% if enquiry.status == 'replied' %}ring-2 ring-emerald-300{% endif %}">Mark replied</button>
  </form>
  {% endif %}
  <form method="post" action="/leads/{{ enquiry.id }}/status/">
    {{ csrf_field(request) }}
    <input type="hidden" name="next" value="/leads/{{ enquiry.id }}/">
    <button type="submit" name="status" value="closed" class="rounded-md border border-red-200 bg-white px-3 py-1.5 text-xs font-semibold text-red-700 {% if enquiry.status == 'closed' %}ring-2 ring-red-300{% endif %}">Close</button>
  </form>
  {% if layout == 'partner' %}
  <a href="/partner/listings/{{ enquiry.business_id }}/edit/" class="rounded-md border border-stone-300 bg-white px-3 py-1.5 text-xs font-semibold text-textMain">Edit listing</a>
  <a href="/leads/?business={{ enquiry.business_id }}" class="rounded-md border border-stone-300 bg-white px-3 py-1.5 text-xs font-semibold text-textMain">Same listing leads</a>
  {% endif %}
</div>
{% endif %}

<div class="mt-6 space-y-3">
  {% for m in messages %}
  <div class="rounded-xl border border-stone-200 bg-white p-4 {% if m.sender_id == request.user.id %}border-brand/30 bg-brand/5{% endif %}">
    <div class="flex items-center justify-between gap-2 text-xs text-textMuted">
      <span class="font-semibold text-textMain">
        {% if m.sender_id == enquiry.client_id %}Client{% elif m.sender_id == request.user.id %}You{% else %}{{ m.sender.email }}{% endif %}
        <span class="font-normal text-textMuted"> · {{ m.sender.email }}</span>
      </span>
      <span>{{ m.created_at.strftime('%d %b %Y %H:%M') }}</span>
    </div>
    <p class="mt-2 whitespace-pre-wrap text-sm text-textMain">{{ m.body }}</p>
  </div>
  {% endfor %}
</div>

{% if enquiry.status == 'closed' %}
<p class="mt-4 rounded-lg border border-stone-200 bg-stone-50 px-3 py-2 text-sm text-textMuted">This enquiry is closed. Reply will reopen it for the client, or mark it open above.</p>
{% endif %}

<form method="post" class="mt-6 space-y-3 rounded-xl border border-stone-200 bg-white p-4 shadow-sm" x-data="{ body: '' }">
  {{ csrf_field(request) }}
  {% if error %}<p class="text-sm text-red-600">{{ error }}</p>{% endif %}
  <label class="block text-sm font-medium text-textMain">Reply</label>
  {% if quick_replies %}
  <div class="flex flex-wrap gap-1.5">
    {% for label, text in quick_replies %}
    <button type="button" class="rounded-full border border-stone-300 bg-stone-50 px-2.5 py-1 text-[11px] font-semibold text-textMuted hover:border-brand hover:text-brand" data-reply="{{ text|e }}" @click="body = $el.getAttribute('data-reply')">{{ label }}</button>
    {% endfor %}
  </div>
  {% endif %}
  <textarea name="body" rows="4" required x-model="body" class="block w-full rounded-md border-0 py-2.5 px-4 text-sm shadow-sm ring-1 ring-inset ring-stone-300 focus:ring-2 focus:ring-brand" placeholder="Write a reply…"></textarea>
  <div class="flex flex-wrap gap-2">
    {{ btn.render(type="submit", text="Send reply", cls="justify-center") }}
  </div>
</form>
