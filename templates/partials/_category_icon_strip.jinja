{# Compact category icons — HTMX filter #}
<nav aria-label="Browse by category" class="w-full">
  <div class="flex items-center justify-between gap-2">
    <h2 class="text-xs font-bold uppercase tracking-wide text-textMuted">Categories</h2>
    <a href="/surat/" class="text-[11px] font-semibold text-brand hover:text-brandHover">All →</a>
  </div>
  <div class="no-scrollbar mt-2 -mx-1 flex gap-1.5 overflow-x-auto px-1 pb-0.5 sm:grid sm:grid-cols-6 sm:overflow-visible lg:grid-cols-12">
    {% for item in hero_categories %}
    <button
      type="button"
      hx-get="/directory/search/?industry={{ item.key }}"
      hx-target="#directory-results"
      hx-indicator="#directory-loading"
      hx-push-url="true"
      hx-on::after-request="document.querySelector('#directory-form select[name=industry]').value='{{ item.key }}'; document.getElementById('directory-results')?.scrollIntoView({behavior:'smooth', block:'start'})"
      class="group flex min-h-[4.5rem] w-[4.75rem] shrink-0 flex-col items-center justify-center gap-1 rounded-lg border border-stone-200 bg-white px-1 py-2 text-center transition hover:border-brand/50 hover:bg-brand/5 focus:outline-none focus:ring-2 focus:ring-brand/30 sm:w-auto {% if industry == item.key %}border-brand bg-brand/5 ring-1 ring-brand/20{% endif %}"
      title="Filter: {{ item.label }}"
    >
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-orange-50 text-brand sm:h-8 sm:w-8">
        {{ item.icon|safe }}
      </span>
      <span class="text-[10px] font-semibold leading-tight text-textMain sm:text-[11px]">{{ item.label }}</span>
    </button>
    {% endfor %}
  </div>
</nav>
