{% extends 'base.jinja' %}

{% block title %}SuratBazar | Find & book local businesses in Surat{% endblock %}
{% block meta_description %}Find and book salons, clinics, opticals, pet care and more in Surat. See hours, prices, and book appointments online on SuratBazar.{% endblock %}
{% block canonical %}{{ canonical_url }}{% endblock %}
{% block json_ld %}
<script type="application/ld+json">{{ website_json_ld|safe }}</script>
{% endblock %}

{% block content %}
<div class="relative min-h-screen overflow-x-hidden" x-data="{ mobileMenuOpen: false }">
  {# Compact hero background #}
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[18rem] bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,_rgba(180,83,9,0.12),_transparent),linear-gradient(180deg,#fff7ed_0%,#FDFBF7_70%,transparent_100%)]"></div>

  <header class="relative z-30 border-b border-stone-200/60 bg-white/85 backdrop-blur-md sticky top-0">
    <div class="mx-auto flex w-full max-w-7xl items-center justify-between gap-3 px-4 py-2.5 sm:px-6 lg:px-8">
      {% set logo_height = 'h-11 sm:h-12' %}
      {% include 'partials/_brand_logo.jinja' %}
      <button
        class="inline-flex items-center justify-center rounded-lg border border-stone-300 bg-white px-3 py-2 text-xs font-semibold text-textMain md:hidden"
        @click="mobileMenuOpen = !mobileMenuOpen"
        type="button"
        aria-label="Toggle navigation"
      >
        Menu
      </button>
      <nav class="hidden items-center gap-2 md:flex">
        <a href="/surat/" class="rounded-lg px-3 py-2 text-sm font-semibold text-textMuted hover:bg-stone-100 hover:text-brand">Surat guide</a>
        <a href="/pricing/" class="rounded-lg px-3 py-2 text-sm font-semibold text-textMuted hover:bg-stone-100 hover:text-brand">Pricing</a>
        {% if request.user.is_authenticated %}
          <a href="/dashboard/" class="rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brandHover">Dashboard</a>
        {% else %}
          <a href="/auth/login/" class="rounded-lg px-3 py-2 text-sm font-semibold text-textMain hover:text-brand">Sign in</a>
          <a href="/auth/register/" class="rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brandHover">List your business</a>
        {% endif %}
      </nav>
    </div>
    <nav x-show="mobileMenuOpen" x-cloak class="border-t border-stone-200 bg-white px-4 py-3 md:hidden">
      <div class="grid grid-cols-2 gap-2">
        <a href="/surat/" class="col-span-2 inline-flex items-center justify-center rounded-lg border border-stone-300 px-3 py-2.5 text-sm font-semibold text-textMain">Surat guide</a>
        <a href="/pricing/" class="col-span-2 inline-flex items-center justify-center rounded-lg border border-stone-300 px-3 py-2.5 text-sm font-semibold text-textMain">Pricing</a>
        {% if request.user.is_authenticated %}
          <a href="/dashboard/" class="col-span-2 inline-flex items-center justify-center rounded-lg bg-brand px-3 py-2.5 text-sm font-semibold text-white">Dashboard</a>
        {% else %}
          <a href="/auth/login/" class="inline-flex items-center justify-center rounded-lg border border-stone-300 px-3 py-2.5 text-sm font-semibold text-textMain">Sign in</a>
          <a href="/auth/register/" class="inline-flex items-center justify-center rounded-lg bg-brand px-3 py-2.5 text-sm font-semibold text-white">List business</a>
        {% endif %}
      </div>
    </nav>
  </header>

  {% include 'partials/_home_hero.jinja' %}

  <section class="relative z-10 mx-auto w-full max-w-7xl px-4 pb-8 sm:px-6 lg:px-8" id="directory-results">
    {% include 'partials/_business_directory_results.jinja' %}
  </section>

  {# Business owner CTA #}
  <section class="relative z-10 border-y border-stone-200 bg-gradient-to-r from-amber-50 to-orange-50/50">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-4 px-4 py-8 sm:flex-row sm:items-center sm:px-6 lg:px-8">
      <div>
        <h2 class="font-display text-xl font-bold text-textMain">Own a business in Surat?</h2>
        <p class="mt-1 text-sm text-textMuted">List free — add services, hours, and take bookings online in minutes.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/pricing/" class="inline-flex items-center justify-center rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm font-semibold text-textMain hover:bg-stone-50">Compare plans</a>
        <a href="/auth/register/" class="inline-flex items-center justify-center rounded-lg bg-brand px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brandHover">List your business free</a>
      </div>
    </div>
  </section>

  {% if industry_hub_rows %}
  <section class="relative z-10 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="font-display text-xl font-bold text-textMain">Explore Surat by industry</h2>
          <p class="mt-1 text-sm text-textMuted">SEO-friendly guides for every category — book or call directly.</p>
        </div>
        <a href="/surat/" class="text-sm font-semibold text-brand hover:text-brandHover">Full Surat guide →</a>
      </div>
      <div class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
        {% for row in industry_hub_rows %}
        <a href="{{ row.path }}" class="flex items-center justify-between rounded-xl border border-stone-200 bg-stone-50/80 px-3 py-2.5 text-sm font-semibold text-textMain transition hover:border-brand/40 hover:bg-white hover:shadow-sm">
          <span class="truncate pr-2">{{ row.seo_label }}</span>
          <span class="shrink-0 rounded-full bg-white px-2 py-0.5 text-[11px] font-bold text-brand">{{ row.count }}</span>
        </a>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}
</div>
{% endblock %}
