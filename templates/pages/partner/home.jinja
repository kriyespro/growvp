{% extends 'pages/partner/base_partner.jinja' %}

{% block title %}Partner dashboard | SuratBazar{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block partner_content %}
<div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
  <article class="rounded-xl border border-stone-200 bg-white p-4 shadow-sm">
    <p class="text-xs font-semibold uppercase text-textMuted">My listings</p>
    <p class="mt-2 text-3xl font-bold text-textMain">{{ listing_count }}</p>
  </article>
  <article class="rounded-xl border border-stone-200 bg-white p-4 shadow-sm">
    <p class="text-xs font-semibold uppercase text-textMuted">Open enquiries</p>
    <p class="mt-2 text-3xl font-bold text-brand">{{ enquiry_stats.open }}</p>
  </article>
  <article class="rounded-xl border border-stone-200 bg-white p-4 shadow-sm">
    <p class="text-xs font-semibold uppercase text-textMuted">Total enquiries</p>
    <p class="mt-2 text-3xl font-bold text-textMain">{{ enquiry_stats.total }}</p>
  </article>
</div>
<div class="mt-8 flex flex-wrap gap-3">
  <a href="/partner/listings/new/" class="inline-flex rounded-md bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brandHover">Create listing</a>
  <a href="/leads/" class="inline-flex rounded-md border border-stone-300 bg-white px-4 py-2.5 text-sm font-semibold text-textMain">Open enquiry inbox</a>
</div>
{% if listings %}
<section class="mt-10">
  <h2 class="font-display text-xl font-bold text-textMain">Recent listings</h2>
  <ul class="mt-4 divide-y divide-stone-200 rounded-xl border border-stone-200 bg-white">
    {% for b in listings[:8] %}
    <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
      <div>
        <a href="/b/{{ b.slug }}/" class="font-semibold text-textMain hover:text-brand">{{ b.name }}</a>
        <p class="text-xs text-textMuted">{{ b.get_industry_type_display() }} · {{ b.plan_label }}</p>
      </div>
      <a href="/partner/listings/{{ b.id }}/edit/" class="text-sm font-semibold text-brand">Edit</a>
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}
{% endblock %}
