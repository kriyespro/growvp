{% extends 'base.jinja' %}

{% block title %}{{ page_title }}{% endblock %}
{% block meta_description %}{{ meta_description }}{% endblock %}
{% block canonical %}{{ canonical_url }}{% endblock %}
{% block json_ld %}
<script type="application/ld+json">{{ breadcrumb_json_ld|safe }}</script>
<script type="application/ld+json">{{ collection_json_ld|safe }}</script>
{% endblock %}

{% block content %}
<div class="min-h-screen bg-stone-50 pb-16">
  <header class="border-b border-stone-200 bg-white">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2 sm:px-6">
      {% set logo_height = 'h-12' %}
      {% include 'partials/_brand_logo.jinja' %}
      <nav class="flex items-center gap-3 text-sm">
        <a href="/surat/" class="font-semibold text-textMuted hover:text-brand">All Surat</a>
        <a href="/?industry={{ industry }}" class="font-semibold text-textMuted hover:text-brand">Search</a>
        <a href="/auth/register/" class="rounded-md bg-brand px-3 py-1.5 font-semibold text-white hover:bg-brandHover">List business</a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <nav class="text-xs font-medium text-textMuted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand">Home</a>
      <span class="mx-1.5 text-stone-300">/</span>
      <a href="/surat/" class="hover:text-brand">Surat</a>
      <span class="mx-1.5 text-stone-300">/</span>
      {% if area_label %}
      <a href="/surat/{{ industry }}/" class="hover:text-brand">{{ industry_label }}</a>
      <span class="mx-1.5 text-stone-300">/</span>
      <span class="text-textMain">{{ area_label }}</span>
      {% else %}
      <span class="text-textMain">{{ industry_label }}</span>
      {% endif %}
    </nav>

    <h1 class="mt-4 font-display text-3xl font-bold tracking-tight text-textMain sm:text-4xl">{{ h1 }}</h1>
    <p class="mt-2 max-w-2xl text-sm text-textMuted">
      {% if stats.total %}{{ stats.total }} listed{% if stats.open_now %} · {{ stats.open_now }} open now{% endif %}{% if stats.bookable %} · {{ stats.bookable }} bookable online{% endif %}{% else %}No listings in this view yet.{% endif %}
    </p>

    {% if areas %}
    <section class="mt-6">
      <h2 class="text-sm font-semibold text-textMain">{% if area_label %}Nearby areas{% else %}Filter by area{% endif %}</h2>
      <div class="mt-2 flex flex-wrap gap-2">
        {% if area_label %}
        <a href="/surat/{{ industry }}/" class="rounded-full border border-stone-300 bg-white px-3 py-1 text-xs font-semibold text-textMuted hover:border-brand/40">All {{ industry_label }}</a>
        {% endif %}
        {% for area in areas[:16] %}
        <a href="/surat/{{ industry }}/{{ area.slug }}/" class="rounded-full border px-3 py-1 text-xs font-semibold {% if area.slug == area_slug %}border-brand bg-brand/5 text-brand{% else %}border-stone-200 bg-white text-textMain hover:border-brand/40{% endif %}">
          {{ area.label }}{% if area.count %} · {{ area.count }}{% endif %}
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if open_now_featured %}
    <section class="mt-8">
      <h2 class="text-sm font-semibold text-textMain">Open right now</h2>
      <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {% for business in open_now_featured %}
        {% include 'partials/_business_card.jinja' %}
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <section class="mt-10">
      <h2 class="font-display text-xl font-bold text-textMain">All listings</h2>
      {% if businesses %}
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {% for business in businesses %}
        {% include 'partials/_business_card.jinja' %}
        {% endfor %}
      </div>
      {% else %}
      <p class="mt-4 rounded-xl border border-dashed border-stone-300 bg-white p-8 text-center text-sm text-textMuted">
        No {{ industry_label|lower }} listed yet.
        <a href="/auth/register/" class="font-semibold text-brand">Be the first</a>.
      </p>
      {% endif %}
    </section>

    {% if related_industries %}
    <section class="mt-12 border-t border-stone-200 pt-8">
      <h2 class="font-display text-lg font-bold text-textMain">Related in Surat</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {% for row in related_industries %}
        <a href="{{ row.path }}" class="rounded-md border border-stone-200 bg-white px-3 py-1.5 text-xs font-semibold text-textMain hover:border-brand/40">{{ row.seo_label }}</a>
        {% endfor %}
      </div>
    </section>
    {% endif %}
  </main>
</div>
{% endblock %}
