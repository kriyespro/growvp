{% if request.GET.get('bulk') %}
<div class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm text-emerald-900">
  Updated {{ request.GET.get('bulk') }} enquir{{ 'y' if request.GET.get('bulk') == '1' else 'ies' }}.
</div>
{% endif %}

{% if enquiry_stats %}
<div class="mb-4 flex flex-wrap gap-2 text-xs">
  <a href="/leads/" class="rounded-full px-3 py-1 font-semibold ring-1 ring-stone-200 {% if not filters.status %}bg-brand/10 text-brand ring-brand/30{% else %}bg-white text-textMuted{% endif %}">All {{ enquiry_stats.total }}</a>
  <a href="/leads/?status=open" class="rounded-full px-3 py-1 font-semibold ring-1 ring-stone-200 {% if filters.status == 'open' %}bg-brand/10 text-brand ring-brand/30{% else %}bg-white text-textMuted{% endif %}">Open {{ enquiry_stats.open }}</a>
  <a href="/leads/?status=replied" class="rounded-full px-3 py-1 font-semibold ring-1 ring-stone-200 {% if filters.status == 'replied' %}bg-emerald-50 text-emerald-800 ring-emerald-200{% else %}bg-white text-textMuted{% endif %}">Replied {{ enquiry_stats.replied }}</a>
  <a href="/leads/?status=closed" class="rounded-full px-3 py-1 font-semibold ring-1 ring-stone-200 {% if filters.status == 'closed' %}bg-stone-200 text-stone-800{% else %}bg-white text-textMuted{% endif %}">Closed {{ enquiry_stats.closed }}</a>
</div>
{% endif %}

<form
  method="get"
  class="mb-4 grid gap-2 rounded-xl border border-stone-200 bg-white p-3 sm:grid-cols-4"
  hx-get="/leads/"
  hx-target="#enquiry-inbox-results"
  hx-trigger="keyup changed delay:400ms from:input[name='q'], change from:select"
  hx-push-url="true"
>
  <input type="search" name="q" value="{{ filters.q or '' }}" placeholder="Search subject, client, listing…" class="rounded-md border border-stone-300 px-3 py-2 text-sm sm:col-span-2">
  <select name="status" class="rounded-md border border-stone-300 px-3 py-2 text-sm">
    <option value="">All statuses</option>
    <option value="open" {% if filters.status == 'open' %}selected{% endif %}>Open / needs reply</option>
    <option value="replied" {% if filters.status == 'replied' %}selected{% endif %}>Replied</option>
    <option value="closed" {% if filters.status == 'closed' %}selected{% endif %}>Closed</option>
  </select>
  {% if listings %}
  <select name="business" class="rounded-md border border-stone-300 px-3 py-2 text-sm">
    <option value="">All listings</option>
    {% for b in listings %}
    <option value="{{ b.id }}" {% if filters.business_id == (b.id ~ '') %}selected{% endif %}>{{ b.name }}</option>
    {% endfor %}
  </select>
  {% else %}
  <select name="sort" class="rounded-md border border-stone-300 px-3 py-2 text-sm">
    <option value="-updated_at" {% if filters.sort == '-updated_at' %}selected{% endif %}>Newest activity</option>
    <option value="-created_at" {% if filters.sort == '-created_at' %}selected{% endif %}>Newest created</option>
    <option value="status" {% if filters.sort == 'status' %}selected{% endif %}>Status</option>
  </select>
  {% endif %}
  {% if listings %}
  <div class="sm:col-span-4 flex flex-wrap items-center gap-2">
    <select name="sort" class="rounded-md border border-stone-300 px-3 py-2 text-sm">
      <option value="-updated_at" {% if filters.sort == '-updated_at' %}selected{% endif %}>Newest activity</option>
      <option value="-created_at" {% if filters.sort == '-created_at' %}selected{% endif %}>Newest created</option>
      <option value="updated_at" {% if filters.sort == 'updated_at' %}selected{% endif %}>Oldest activity</option>
      <option value="status" {% if filters.sort == 'status' %}selected{% endif %}>Status A–Z</option>
    </select>
    <button type="submit" class="rounded-md bg-stone-900 px-3 py-2 text-sm font-semibold text-white">Apply</button>
  </div>
  {% endif %}
</form>

<div id="enquiry-inbox-results">
  {% include 'partials/_enquiry_inbox.jinja' %}
</div>
