{% extends 'base.jinja' %}

{% block title %}Enquiries | SuratBazar{% endblock %}

{% block content %}
{% if layout == 'account' %}
<div class="min-h-screen bg-stone-50">
  <header class="border-b border-stone-200 bg-white">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
      <h1 class="font-bold text-textMain">My enquiries</h1>
      <a href="/account/" class="text-sm font-semibold text-brand">Account</a>
    </div>
  </header>
  <main class="mx-auto max-w-3xl px-4 py-8">
    {% include 'partials/_enquiry_inbox_page.jinja' %}
  </main>
</div>
{% else %}
<div class="space-y-4 px-4 py-8 sm:px-6">
  <h2 class="text-2xl font-bold text-textMain">Enquiries</h2>
  {% include 'partials/_enquiry_inbox_page.jinja' %}
</div>
{% endif %}
{% endblock %}
