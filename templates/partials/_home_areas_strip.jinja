{% if area_hub_rows %}
<section class="mt-5">
  <div class="flex items-center justify-between gap-2">
    <h2 class="text-sm font-semibold text-textMain">Popular areas in Surat</h2>
    <a href="/surat/" class="text-xs font-semibold text-brand hover:text-brandHover">Area guides →</a>
  </div>
  <div class="mt-2 flex flex-wrap gap-2">
    {% for area in area_hub_rows %}
    <button
      type="button"
      hx-get="/directory/search/?q={{ area.label|urlencode }}"
      hx-target="#directory-results"
      hx-indicator="#directory-loading"
      hx-push-url="true"
      hx-on::after-request="document.getElementById('directory-q').value='{{ area.label }}'; document.getElementById('directory-results')?.scrollIntoView({behavior:'smooth', block:'start'})"
      class="inline-flex items-center gap-1 rounded-full border border-stone-200 bg-white px-3 py-1.5 text-xs font-semibold text-textMain shadow-sm transition hover:border-brand/40 hover:bg-brand/5"
    >
      {{ area.label }}
      <span class="text-[10px] font-medium text-textMuted">{{ area.count }}</span>
    </button>
    {% endfor %}
  </div>
</section>
{% endif %}
