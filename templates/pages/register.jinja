{% extends 'base.jinja' %}
{% import 'components/input.jinja' as input %}
{% import 'components/button.jinja' as btn %}
{% import 'components/card.jinja' as card %}

{% block title %}Register your business | SuratBazar{% endblock %}
{% block meta_description %}List your local business on SuratBazar. Create a free account, add services, and start taking bookings online.{% endblock %}

{% block content %}
<div class="min-h-screen bg-gradient-to-b from-amber-50/50 to-creameBg px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto w-full max-w-lg">
    <div class="mb-8 text-center">
      {% set logo_height = 'h-16' %}
      {% set logo_class = 'mx-auto inline-flex' %}
      {% include 'partials/_brand_logo.jinja' %}
      <a href="/" class="mt-3 inline-block text-sm font-semibold text-brand hover:text-brandHover">← Back to directory</a>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-textMain">List your business</h1>
      <p class="mt-2 text-sm text-textMuted">Create your account, then finish your public listing so customers can find and book you.</p>
      <div class="mx-auto mt-5 grid max-w-md grid-cols-3 gap-2 text-center text-xs font-semibold">
        <a href="/auth/register/?as=business" class="rounded-md border border-brand bg-brand/5 px-2 py-2 text-brand">Business</a>
        <a href="/auth/register/?as=partner" class="rounded-md border border-stone-200 bg-white px-2 py-2 text-textMuted hover:border-brand/40">Partner</a>
        <a href="/auth/register/?as=client" class="rounded-md border border-stone-200 bg-white px-2 py-2 text-textMuted hover:border-brand/40">Client</a>
      </div>
      <ol class="mx-auto mt-5 flex max-w-sm items-center justify-between text-xs font-semibold text-textMuted">
        <li class="text-brand">1. Account</li>
        <li class="text-stone-300">——</li>
        <li>2. Public profile</li>
        <li class="text-stone-300">——</li>
        <li>3. Services</li>
      </ol>
    </div>

    {% set form_content %}
    <form hx-post="/auth/register/" hx-target="this" hx-swap="outerHTML" class="space-y-5">
      {{ csrf_field(request) }}
      {{ input.render("Business name", "business_name", required=True, value=form.business_name.value() or "", errors=form.business_name.errors|join(', ') if form.business_name.errors else "") }}

      <div class="space-y-1">
        <label for="industry_type" class="block text-sm font-medium text-textMain">Business category</label>
        <p class="mb-2 text-xs text-textMuted">Pick the closest match — you can change this later.</p>
        <select
          id="industry_type"
          name="industry_type"
          required
          class="block w-full rounded-md border-0 bg-white py-3 px-4 text-base text-textMain shadow-sm ring-1 ring-inset ring-stone-300 focus:ring-2 focus:ring-inset focus:ring-brand sm:py-2.5 sm:text-sm appearance-none"
        >
          <option value="" {% if not form.industry_type.value() %}selected{% endif %}>Select a category</option>
          {% for group_label, group_choices in industry_groups %}
          <optgroup label="{{ group_label }}">
            {% for value, label in group_choices %}
            <option value="{{ value }}" {% if form.industry_type.value() == value %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </optgroup>
          {% endfor %}
        </select>
        {% if form.industry_type.errors %}<p class="text-xs text-red-500 mt-1">{{ form.industry_type.errors|join(', ') }}</p>{% endif %}
      </div>

      {{ input.render("Business phone", "public_phone", required=True, value=form.public_phone.value() or "", placeholder="10-digit mobile", errors=form.public_phone.errors|join(', ') if form.public_phone.errors else "") }}
      {{ input.render("Email address", "email", type="email", required=True, value=form.email.value() or "", errors=form.email.errors|join(', ') if form.email.errors else "") }}
      {{ input.render("Password", "password", type="password", required=True, placeholder="At least 8 characters", errors=form.password.errors|join(', ') if form.password.errors else "") }}
      {{ input.render("Confirm password", "password_confirm", type="password", required=True, errors=form.password_confirm.errors|join(', ') if form.password_confirm.errors else "") }}

      {% if form.non_field_errors() %}
      <p class="text-sm text-red-600">{{ form.non_field_errors()|join(' ') }}</p>
      {% endif %}

      <div class="pt-2">
        {{ btn.render(type="submit", text="Continue to profile setup", cls="w-full justify-center") }}
      </div>
      <p class="text-center text-sm text-textMuted">
        Already listed?
        <a href="/auth/login/" class="font-semibold text-brand hover:text-brandHover">Sign in</a>
      </p>
    </form>
    {% endset %}

    {{ card.render(content=form_content) }}
  </div>
</div>
{% endblock %}
