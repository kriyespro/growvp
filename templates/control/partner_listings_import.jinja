{% extends 'control/base_control.jinja' %}

{% block title %}Import partner listings{% endblock %}
{% block page_title %}Import partner listings{% endblock %}

{% block content %}
<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <div>
    <a href="{{ url('control:partner_listings') }}" class="text-xs font-semibold text-control-link hover:underline">← Partner listings</a>
    <p class="mt-1 text-sm text-control-muted">CSV, Excel (.xlsx), or public Google Sheet. Max 200 rows.</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="{{ url('control:partner_listings_import_sample') }}?format=csv" class="rounded-md border border-control-border px-3 py-2 text-xs font-semibold text-control-muted hover:text-white">Sample CSV</a>
    <a href="{{ url('control:partner_listings_import_sample') }}?format=xlsx" class="rounded-md border border-control-border px-3 py-2 text-xs font-semibold text-control-muted hover:text-white">Sample Excel</a>
  </div>
</div>

<div class="mb-6 rounded-xl border border-control-border bg-control-panel p-4 text-sm text-control-muted">
  <p class="font-semibold text-control-text">Columns</p>
  <p class="mt-2 text-xs">{{ columns|join(', ') }}</p>
  <p class="mt-2">Optionally assign all new rows to a marketing partner below (sets <code class="text-control-accent">created_by</code>).</p>
</div>

{% if error %}
<div class="mb-4 rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-300">{{ error }}</div>
{% endif %}

{% if result %}
<div class="mb-6 rounded-xl border border-control-border bg-control-panel p-4">
  <p class="font-semibold text-control-text">
    Created {{ result.created_count }}
    {% if result.error_count %} · {{ result.error_count }} errors{% endif %}
  </p>
  {% if result.created %}
  <ul class="mt-3 max-h-40 space-y-1 overflow-y-auto text-sm text-emerald-400">
    {% for row in result.created %}
    <li>Row {{ row.row_number }}: <a class="underline" href="/b/{{ row.slug }}/" target="_blank">{{ row.name }}</a></li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if result.errors %}
  <ul class="mt-3 max-h-40 space-y-1 overflow-y-auto text-sm text-red-300">
    {% for row in result.errors %}
    <li>Row {{ row.row_number }}{% if row.name %} ({{ row.name }}){% endif %}: {{ row.error }}</li>
    {% endfor %}
  </ul>
  {% endif %}
  <a href="{{ url('control:partner_listings') }}" class="mt-4 inline-block text-sm font-semibold text-control-link hover:underline">View partner listings →</a>
</div>
{% endif %}

<form method="post" enctype="multipart/form-data" class="space-y-5 rounded-xl border border-control-border bg-control-panel p-5">
  {{ csrf_field(request) }}
  {% if form.non_field_errors() %}
  <div class="rounded-lg border border-red-500/40 bg-red-500/10 px-3 py-2 text-sm text-red-300">
    {% for e in form.non_field_errors() %}{{ e }}{% endfor %}
  </div>
  {% endif %}

  <div>
    <label class="block text-sm font-semibold" for="id_partner_id">Assign to partner (optional)</label>
    <select id="id_partner_id" name="partner_id" class="mt-1 w-full rounded-md border border-control-border bg-control-bg px-3 py-2 text-sm">
      <option value="">— Admin / no partner —</option>
      {% for p in partners %}
      <option value="{{ p.id }}">{{ p.email }}</option>
      {% endfor %}
    </select>
  </div>

  <div>
    <label class="block text-sm font-semibold" for="id_file">CSV or Excel</label>
    <input id="id_file" type="file" name="file" accept=".csv,.tsv,.xlsx,.xlsm,.txt" class="mt-1 block w-full text-sm text-control-muted">
  </div>

  <p class="text-center text-xs uppercase tracking-wide text-control-muted">or</p>

  <div>
    <label class="block text-sm font-semibold" for="id_google_sheet_url">Google Sheet URL</label>
    <input id="id_google_sheet_url" type="url" name="google_sheet_url" value="{{ form.google_sheet_url.value() or '' }}" placeholder="https://docs.google.com/spreadsheets/d/…" class="mt-1 w-full rounded-md border border-control-border bg-control-bg px-3 py-2 text-sm">
    <p class="mt-1 text-xs text-control-muted">Share → Anyone with the link → Viewer</p>
  </div>

  <button type="submit" class="rounded-md bg-control-accent px-4 py-2 text-sm font-semibold text-black hover:opacity-90">Import listings</button>
</form>
{% endblock %}
