{% if area_hub_rows %}
<div class="mt-3 flex flex-wrap items-center gap-1.5">
  <span class="text-[11px] font-semibold text-textMuted">Areas:</span>
  {% for area in area_hub_rows %}
  <button
    type="button"
    hx-get="/directory/search/?q={{ area.label|urlencode }}"
    hx-target="#directory-results"
    hx-indicator="#directory-loading"
    hx-push-url="true"
    hx-on::after-request="document.getElementById('directory-q').value='{{ area.label }}'; document.getElementById('directory-results')?.scrollIntoView({behavior:'smooth', block:'start'})"
    class="inline-flex items-center gap-1 rounded-full border border-stone-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-textMain transition hover:border-brand/40 hover:bg-brand/5"
  >
    {{ area.label }}
    <span class="font-medium text-textMuted">{{ area.count }}</span>
  </button>
  {% endfor %}
</div>
{% endif %}
