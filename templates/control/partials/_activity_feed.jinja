<ul class="space-y-3">
  {% if not activity %}
  <li class="text-sm text-control-muted">No recent activity.</li>
  {% endif %}
  {% for item in activity %}
  <li class="border-b border-control-border/60 pb-3 last:border-0 last:pb-0">
    <div class="flex items-start justify-between gap-2">
      <p class="text-sm font-medium text-control-text">{{ item.title }}</p>
      <span class="shrink-0 font-mono text-[10px] text-control-muted">
        {% if item.at %}{{ item.at.strftime('%d %b %H:%M') }}{% endif %}
      </span>
    </div>
    <p class="mt-0.5 text-xs text-control-muted">{{ item.detail }}</p>
    <p class="mt-1 text-[10px] uppercase tracking-wide text-control-muted/80">{{ item.kind }} · {{ item.actor }}</p>
  </li>
  {% endfor %}
</ul>
